generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ──────────────────────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  timezone     String        @default("UTC")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  commitments  Commitment[]
  dailyRecords DailyRecord[]
  dailyReflections DailyReflection[]
  streakState  StreakState?
}

// ─── Invites ───────────────────────────────────────────────────────────────────

model Invite {
  id        String   @id @default(cuid())
  code      String   @unique
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Commitments (Disciplines) ─────────────────────────────────────────────────

model Commitment {
  id            String        @id @default(cuid())
  userId        String
  title         String
  type          String        // 'duration' | 'quantity' | 'count' | 'binary'
  targetValue   Float
  unit          String        @default("min")
  frequency     String        @default("daily")
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyRecords  DailyRecord[]
}

// ─── Daily Records (per-commitment per-day snapshots) ──────────────────────────

model DailyRecord {
  id            String     @id @default(cuid())
  commitmentId  String
  userId        String
  date          String     // YYYY-MM-DD
  targetValue   Float      // snapshot of target at time of recording
  actualValue   Float      @default(0)
  status        String     @default("missed") // 'missed' | 'showed_up' | 'complete'
  note          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  commitment    Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commitmentId, date])
}

// ─── Streak State Machine ──────────────────────────────────────────────────────

model StreakState {
  id                 String   @id @default(cuid())
  userId             String   @unique
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  lastEvaluatedDate  String?  // YYYY-MM-DD
  graceDayActive     Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Daily Reflection ──────────────────────────────────────────────────────────

model DailyReflection {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
}