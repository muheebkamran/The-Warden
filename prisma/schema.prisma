generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User ──────────────────────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  timezone     String        @default("UTC")
  preferredTheme String      @default("midnight-galaxy")
  avatarUrl    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  commitments  Commitment[]
  dailyRecords DailyRecord[]
  dailyReflections DailyReflection[]
  streakState  StreakState?
  books        Book[]
  financeProfile FinanceProfile?
  transactions   Transaction[]
  impulseLocks   ImpulseLock[]
  financialGoals FinancialGoal[]
  bills          Bill[]
}

// ─── Invites ───────────────────────────────────────────────────────────────────

model Invite {
  id        String   @id @default(cuid())
  code      String   @unique
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── Commitments (Disciplines) ─────────────────────────────────────────────────

model Commitment {
  id            String        @id @default(cuid())
  userId        String
  title         String
  type          String        // 'duration' | 'quantity' | 'count' | 'binary'
  targetValue   Float
  unit          String        @default("min")
  frequency     String        @default("daily")
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyRecords  DailyRecord[]

  @@index([userId, isActive])
}

// ─── Daily Records (per-commitment per-day snapshots) ──────────────────────────

model DailyRecord {
  id            String     @id @default(cuid())
  commitmentId  String
  userId        String
  date          String     // YYYY-MM-DD
  targetValue   Float      // snapshot of target at time of recording
  actualValue   Float      @default(0)
  status        String     @default("missed") // 'missed' | 'showed_up' | 'complete'
  note          String?
  photoUrl      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  commitment    Commitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commitmentId, date])
  @@index([userId, date])
  @@index([userId])
}

// ─── Streak State Machine ──────────────────────────────────────────────────────

model StreakState {
  id                 String   @id @default(cuid())
  userId             String   @unique
  currentStreak      Int      @default(0)
  longestStreak      Int      @default(0)
  lastEvaluatedDate  String?  // YYYY-MM-DD
  graceDayActive     Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Daily Reflection ──────────────────────────────────────────────────────────

model DailyReflection {
  id        String   @id @default(cuid())
  userId    String
  date      String   // YYYY-MM-DD
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
}

// ─── Reading Room (Books & Reading Progress) ───────────────────────────────────

model Book {
  id           String        @id @default(cuid())
  userId       String
  title        String
  author       String?
  fileUrl      String
  coverUrl     String?
  totalPages   Int           @default(1)
  currentPage  Int           @default(1)
  isCompleted  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions     ReadingSession[]

  @@index([userId])
}

model ReadingSession {
  id          String    @id @default(cuid())
  bookId      String
  userId      String
  minutesRead Int       @default(0)
  pagesRead   Int       @default(0)
  date        String    // YYYY-MM-DD
  createdAt   DateTime  @default(now())

  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, date])
  @@index([userId, date])
  @@index([bookId])
}

// ─── Financial Discipline Chamber ──────────────────────────────────────────────

model FinanceProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  monthlyBudget Float     @default(2000)
  currency      String    @default("$")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String    @id @default(cuid())
  userId      String
  amount      Float
  category    String    // 'needs' | 'wants' | 'food' | 'transport' | 'entertainment' | 'bills' | 'other'
  type        String    @default("expense") // 'expense' | 'income'
  date        String    // YYYY-MM-DD
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, category])
}

model ImpulseLock {
  id               String    @id @default(cuid())
  userId           String
  itemName         String
  amount           Float
  category         String    @default("impulse")
  urgencyRationale String?
  coolsAt          DateTime  // Timestamp when 48h cooling ends
  status           String    @default("cooling") // 'cooling' | 'killed' | 'purchased'
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model FinancialGoal {
  id            String    @id @default(cuid())
  userId        String
  title         String
  targetAmount  Float
  currentAmount Float     @default(0)
  category      String    @default("fortress") // 'emergency_fund' | 'debt_freedom' | 'investment' | 'fortress'
  targetDate    String?   // YYYY-MM-DD
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Bill {
  id        String   @id @default(cuid())
  userId    String
  billName  String
  amount    Float
  date      String   // YYYY-MM-DD
  photoUrl  String?
  paid      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, paid])
}
