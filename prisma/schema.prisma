generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Goal {
  id            String       @id @default(cuid())
  name          String
  targetMinutes Int
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  records       GoalRecord[]
  notes         Note[]
}

model DailyRecord {
  id           String       @id @default(cuid())
  date         String       @unique
  sleepTime    String?
  wakeTime     String?
  phoneMinutes Int?
  reflection   String?
  createdAt    DateTime     @default(now())
  goals        GoalRecord[]
}

model GoalRecord {
  id            String      @id @default(cuid())
  dailyRecordId String
  goalId        String
  targetMinutes Int
  actualMinutes Int         @default(0)
  showedUp      Boolean     @default(false)

  dailyRecord   DailyRecord @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)
  goal          Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([dailyRecordId, goalId])
}

model Book {
  id          String   @id @default(cuid())
  title       String
  fileName    String
  fileUrl     String
  currentPage Int      @default(1)
  totalPages  Int?     @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Promise Vault ─────────────────────────────────────────────────────────────

model Promise {
  id            String          @id @default(cuid())
  date          String          // YYYY-MM-DD (the day the promise was made)
  text          String          // "Study Python for 2 hours"
  targetMinutes Int?            // optional: quantified target
  status        String          @default("pending") // pending | kept | partial | missed
  actualMinutes Int             @default(0)
  keptAt        DateTime?       // timestamp when marked kept
  notes         String?         // optional end-of-day note
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model IdentityStats {
  id              String   @id @default("singleton")
  longestStreak   Int      @default(0)
  totalPromised   Int      @default(0)
  totalKept       Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model Note {
  id        String   @id @default(cuid())
  goalId    String?
  content   String
  createdAt DateTime @default(now())

  goal      Goal?    @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

// ─── User Profile & Settings ──────────────────────────────────────────────────

model UserSettings {
  id              String   @id @default("singleton")
  name            String   @default("Muheeb")
  accentColor     String   @default("#2563eb")
  backgroundColor String   @default("#f4f6fa")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id        String   @id @default("singleton")
  name      String   @default("Muheeb")
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}